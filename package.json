{
  "name": "wi-components",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build components",
    "pack:lib": "node scripts/pack-lib.mjs",
    "e2e-consumer:sync": "node scripts/sync-e2e-consumer.mjs",
    "e2e-consumer:serve": "pnpm --dir apps/e2e-consumer start",
    "e2e-consumer:build": "pnpm --dir apps/e2e-consumer build",
    "generate:icons": "node scripts/generate-heroicons.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "storybook": "ng run components:storybook",
    "build-storybook": "ng run components:build-storybook"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "less",
      "lmdb",
      "msgpackr-extract",
      "nx"
    ]
  },
  "dependencies": {
    "@angular/aria": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@spartan-ng/brain": "^1.1.2",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@angular-devkit/architect": "^0.2200.0",
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular/animations": "^22.0.0",
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@spartan-ng/cli": "^1.1.2",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/angular-vite": "^10.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.3",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.1.1",
    "ng-packagr": "^22.0.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vite": "^8.1.5",
    "vitest": "^4.0.8"
  }
}
