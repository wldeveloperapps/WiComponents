{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint", "@spartan-ng/cli"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "components": {
      "projectType": "library",
      "root": "projects/components",
      "sourceRoot": "projects/components/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/components/tsconfig.spec.json",
            "include": ["**/*.spec.ts"],
            "coverageInclude": [
              "projects/components/button/src/**/*.ts",
              "projects/components/data-display/src/**/*.ts",
              "projects/components/forms/src/**/*.ts",
              "projects/components/icon/src/**/*.ts",
              "projects/components/overlays/src/**/*.ts"
            ],
            "coverageExclude": [
              "**/*.spec.ts",
              "**/*.stories.ts",
              "**/heroicons/**",
              "**/public-api.ts"
            ],
            "coverageReporters": ["text", "text-summary", "html", "lcov", "json-summary"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/components/**/*.ts", "projects/components/**/*.html"],
            "eslintConfig": "eslint.config.js"
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": "projects/components/.storybook",
            "browserTarget": "components:build",
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": "projects/components/.storybook",
            "browserTarget": "components:build",
            "outputDir": "storybook-static"
          }
        }
      }
    }
  }
}
