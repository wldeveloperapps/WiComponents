{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "tailwindcss-server": {
      "command": "npx",
      "args": ["-y", "tailwindcss-mcp-server"]
    },
    "wiloc-ui": {
      "command": "node",
      "args": ["./packages/wiloc-ui-mcp/dist/index.js"]
    },
    "spartan-ng": {
      "command": "npx",
      "args": ["-y", "spartan-ng-mcp"]
    },
    "storybook-mcp": {
      "command": "npx",
      "args": ["-y", "@raksbisht/storybook-mcp"],
      "env": {
        "STORYBOOK_URL": "http://localhost:6006"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "test-watch": {
      "command": "npx",
      "args": ["-y", "test-warden"]
    }
  }
}
